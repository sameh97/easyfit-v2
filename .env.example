# Copy to .env and fill in. Used by docker-compose.yml and the backend.

# Postgres (also used to initialise the db container on first start)
DB_USER=easyfit
DB_PASS=change-me
PGSQL_DB=easyfit
# Only used when running the backend outside Docker; compose overrides these
DB_HOST=localhost
DB_PORT=5432

# Backend
APP_PORT=3000
TOKEN_SECRET=generate-a-long-random-string
ADMIN_PASSWORD=change-me

# S3 image uploads
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=

# Host port the web app is published on (docker compose)
WEB_PORT=80
